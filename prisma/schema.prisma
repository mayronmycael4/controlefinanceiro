// Schema do sistema de controle financeiro (PostgreSQL / Supabase).
// Enums nativos não usados de propósito — mantemos String com validação na app
// (histórico de quando o banco era SQLite, que não suporta enums nativos).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Usuários / autenticação / auditoria ----
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // hash no formato "salt:hash"
  role      String   @default("user") // admin | user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  activityLogs ActivityLog[]
  goals        Goal[]
  accounts     Account[]
  creditCards  CreditCard[]
  categories   Category[]
  recurrings   Recurring[]
  transactions Transaction[]
  budgets      Budget[]
  fiis         Fii[]
  fiiTransactions FiiTransaction[]
  fiiDividends    FiiDividend[]
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatingId String? // se o admin está "vendo como" outro usuário
  createdAt       DateTime  @default(now())
  expiresAt       DateTime

  @@index([userId])
}

// Log de atividades: registra ações relevantes feitas por cada usuário.
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String // ex.: "transacao.criar"
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Metas de economia (objetivos)
model Goal {
  id        String    @id @default(cuid())
  name      String
  target    Float
  saved     Float     @default(0)
  deadline  DateTime?
  color     String    @default("var(--color-chart-1)")
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id             String        @id @default(cuid())
  name           String
  type           String        @default("carteira") // carteira | corrente | poupanca
  color          String        @default("var(--color-chart-1)")
  initialBalance Float         @default(0)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  recurrings     Recurring[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditCard {
  id           String        @id @default(cuid())
  name         String
  brand        String        @default("")
  limit        Float         @default(0)
  closingDay   Int           @default(1)
  dueDay       Int           @default(10)
  color        String        @default("var(--color-chart-2)")
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  recurrings   Recurring[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  kind         String        @default("despesa") // receita | despesa
  color        String        @default("var(--color-chart-3)")
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  budgets      Budget[]
  recurrings   Recurring[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Transações recorrentes / fixas (assinaturas, salário, aluguel...)
// Funcionam como modelo: geram lançamentos pendentes a cada mês.
model Recurring {
  id            String    @id @default(cuid())
  description   String
  amount        Float
  kind          String    @default("despesa") // receita | despesa
  frequency     String    @default("mensal") // mensal | semanal | quinzenal | trimestral | semestral | anual
  dayOfMonth    Int       @default(1) // dia do mês (mensal, trimestral, semestral, anual)
  dayOfWeek     Int? // 0=domingo .. 6=sábado (semanal, quinzenal)
  month         Int? // 1-12 (mês âncora: anual, trimestral, semestral)
  color         String    @default("var(--color-chart-1)")
  active        Boolean   @default(true)
  lastGenerated DateTime? // data até a qual já foi materializado
  createdAt     DateTime  @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  amount      Float
  kind        String   @default("despesa") // receita | despesa
  status      String   @default("pago") // pago | pendente
  date        DateTime
  createdAt   DateTime @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  recurringId String?
  recurring   Recurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  installmentId String? // agrupa parcelas de uma mesma compra parcelada

  // Etiquetas livres, minúsculas e separadas por vírgula (ex.: "viagem,trabalho")
  tags String @default("")

  // Data real da compra (cartão). `date` guarda a data da fatura; este campo,
  // a data em que a compra foi feita. Nulo em lançamentos de conta.
  purchaseDate DateTime?

  // Pagamento de fatura de cartão: move dinheiro (afeta saldo da conta),
  // mas NÃO conta como despesa nos relatórios (evita contagem dupla).
  isTransfer Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([kind])
  @@index([status])
  @@index([installmentId])
  @@index([userId])
}

model Budget {
  id         String    @id @default(cuid())
  amount     Float
  month      Int // 1-12
  year       Int
  categoryId String? // null = orçamento total do mês
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year, categoryId])
}

// Carteira de Fundos Imobiliários (FIIs) — controle separado do patrimônio geral.
model Fii {
  id             String    @id @default(cuid())
  ticker         String // ex.: MXRF11
  name           String    @default("")
  color          String    @default("var(--color-chart-1)")
  currentPrice   Float     @default(0) // cotação atual (manual ou via API)
  priceUpdatedAt DateTime?
  dy             Float? // dividend yield informado manualmente (%)
  pvp            Float? // P/VP informado manualmente
  createdAt      DateTime  @default(now())

  transactions FiiTransaction[]
  dividends    FiiDividend[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
}

model FiiTransaction {
  id        String   @id @default(cuid())
  fiiId     String
  fii       Fii      @relation(fields: [fiiId], references: [id], onDelete: Cascade)
  kind      String   @default("compra") // compra | venda
  quantity  Int
  price     Float // preço unitário da operação
  date      DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fiiId])
  @@index([userId])
}

model FiiDividend {
  id        String   @id @default(cuid())
  fiiId     String
  fii       Fii      @relation(fields: [fiiId], references: [id], onDelete: Cascade)
  amount    Float // valor total recebido
  date      DateTime // mês/data de referência do pagamento
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fiiId])
  @@index([userId])
}

